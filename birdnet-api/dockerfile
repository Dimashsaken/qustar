FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg wget git \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements first for better Docker layer caching
COPY birdnet-api/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Clone BirdNET-Analyzer
RUN git clone --depth 1 https://github.com/birdnet-team/BirdNET-Analyzer BirdNET-Analyzer \
 && pip install --no-cache-dir ./BirdNET-Analyzer

# Download the BirdNET model file that the server expects
RUN mkdir -p BirdNET-Analyzer/models \
 && wget -q https://github.com/woheller69/whoBIRD-TFlite/raw/master/BirdNET_GLOBAL_6K_V2.4_Model_FP32.tflite \
     -O BirdNET-Analyzer/models/BirdNET_GLOBAL_6K_V2.4_Model_FP32.tflite

# Copy our server file
COPY birdnet-api/server.py .

ENV PORT=8080 
# 8080 for local dev; Railway injects a real port at runtime
EXPOSE $PORT
CMD ["bash", "-c", "python server.py --model BirdNET-Analyzer/models/BirdNET_GLOBAL_6K_V2.4_Model_FP32.tflite --port $PORT"]
{
  "expo": {
    "name": "qustar",
    "slug": "qustar",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/qustar-logo.png",
    "scheme": "qustar",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,

      "bundleIdentifier": "com.dimash-saken.qustar",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "This app uses the microphone to record bird sounds for identification."
      }
    },
    "android": {
      "supportsTablet": false,
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.dimash_saken.qustar",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/qustar-logo.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/qustar-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow QuStar to record birdsong for identification."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5f4f0424-5e1c-4270-b28c-65550768d696"
      }
    }
  }
}

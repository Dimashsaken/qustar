{
  "expo": {
    "name": "qustar",
    "slug": "qustar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "qustar",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/20250630_1434_Силуэт гуся_simple_compose_01jyzrpehweg5rft3asfm8grm2.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F5F5",
      "dark": {
        "image": "./assets/images/20250630_1434_Силуэт гуся_simple_compose_01jyzrpehweg5rft3asfm8grm2.png",
        "resizeMode": "contain",
        "backgroundColor": "#151718"
      }
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
